def cleanup_chrome():
    """Forcibly closes the ChromeDriver, the browser process, and ALL spawned child tabs/workers."""
    global browser_pid, driver_pid
    
    # 1. Attempt graceful close through the WebDriver interface
    try:
        driver.quit()
    except Exception:
        pass
    
    # 2. Extract the true Browser PID dynamically if not already captured
    if not browser_pid:
        try:
            # Service process gives us the driver, its child is the actual browser executable
            browser_pid = driver.service.process.pid
        except Exception:
            pass

    # 3. Forcibly terminate the Process Tree (/T) and ignore errors (>nul 2>&1)
    try:
        if driver_pid:
            os.system(f"taskkill /F /T /PID {driver_pid} >nul 2>&1")
    except Exception:
        pass

    try:
        if browser_pid:
            os.system(f"taskkill /F /T /PID {browser_pid} >nul 2>&1")
    except Exception:
        pass
        
    # 4. Final safety blanket: Kill orphan processes tied specifically to this automation tool name
    # (Matches the 'YouTubeToggle' execution environment)
    os.system("taskkill /F /IM chromedriver.exe /FI \"STATUS eq RUNNING\" >nul 2>&1")



def emergency_exit():
    """Signalling a clean shutdown down the thread ladder before forcing termination."""
    stop_event.set()  # Signals the focus_monitor_loop to break its while condition
    cleanup_chrome()
    time.sleep(0.2)   # Gives the monitor loop thread a moment to exit gracefully
    os._exit(0)



# Register cleanup functions for system hooks
atexit.register(cleanup_chrome)

def signal_handler(signum, frame):
    cleanup_chrome()
    os._exit(0)

signal.signal(signal.SIGTERM, signal_handler)
signal.signal(signal.SIGINT, signal_handler)


def request_password():
    """Creates a temporary, focused dialog box to prompt for the password."""
    root = tk.Tk()
    root.withdraw()  
    root.attributes("-topmost", True)  
    root.update()
    
    user_input = simpledialog.askstring("Access Required", "Enter password to unhide:", show='*', parent=root)
    root.destroy()
    return user_input


