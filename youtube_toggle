import selenium.common.exceptions  # Ensure this import is available, or it will catch broad Exception below

def focus_monitor_loop():
    """
    Background monitoring loop optimized to prevent memory leaks,
    handle sudden browser disconnections, and prevent script crashes.
    """
    global is_hidden
    while not stop_event.is_set():
        try:
            if hwnd and not is_hidden:
                # 1. Health check verification to make sure Chrome is still running
                try:
                    driver.execute_script("return navigator.onLine;")
                except Exception:
                    log_event("Browser connection severed in monitor loop. Triggering exit.", "error")
                    emergency_exit()
                    break

                # 2. Check window foreground status
                active_hwnd = user32.GetForegroundWindow()
                
                # If the user clicks away, presses Alt+Tab, or another app steals focus
                if active_hwnd != hwnd and active_hwnd != 0:
                    time.sleep(0.1)  # Debounce layer to confirm deliberate defocus
                    if user32.GetForegroundWindow() != hwnd:
                        hide_window()
                        
                del active_hwnd
        except Exception:
            pass  # Absorb transient OS tracking communication hiccups silently
            
        time.sleep(0.2)  # Maintain rest window to lower CPU footprints
        gc.collect()


def process_unhide():
