def setup_automation_logger(logfile="automation_runtime.log"):
    """Configures a background rolling diagnostic log to trace event sequences safely."""
    logging.basicConfig(
        filename=logfile,
        level=logging.INFO,
        format='%(asctime)s [%(levelname)s] %(message)s',
        datefmt='%Y-%m-%d %H:%M:%S'
    )
    logging.info("--- Automation Session Initialised ---")

def log_event(message, level="info"):
    """Thread-safe interface to write diagnostic breadcrumbs."""
    try:
        if level == "info":
            logging.info(message)
        elif level == "error":
            logging.error(message)
    except Exception:
        pass

