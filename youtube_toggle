        user32.SetForegroundWindow(hwnd)
        
        # 2. Release topmost hold so you can interact with other apps normally
        time.sleep(0.1)
        user32.SetWindowPos(hwnd, -2, 0, 0, 0, 0, 0x0001 | 0x0002 | 0x0040) # HWND_NOTOPMOST

        try:
            driver.execute_script('const videos = document.querySelectorAll("video"); videos.forEach(v => { v.muted = false; });')
        except Exception:
            pass
        is_hidden = False





